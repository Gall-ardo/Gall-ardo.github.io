---
interface Item {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  items: Item[];
  className?: string;
}

const { items, className = 'socials' } = Astro.props;
---

<div class={className}>
  {
    items.map((item) => (
      <a
        href={item.href}
        target={item.href.startsWith('http') ? '_blank' : undefined}
        rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={item.label}
        title={item.label}
      >
        {item.icon ? <Fragment set:html={item.icon} /> : item.label}
      </a>
    ))
  }
</div>
