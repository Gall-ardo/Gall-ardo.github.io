---
---

<canvas id="bg-canvas" aria-hidden="true"></canvas>

<style>
  #bg-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  type Pt = { x: number; y: number };

  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    // --- Theme colors (track light/dark) ---
    let dotColor = 'rgba(26,26,26,0.55)';
    let lineColor = '26,26,26';
    function readColors() {
      const s = getComputedStyle(document.documentElement);
      dotColor = s.getPropertyValue('--particle-dot').trim() || dotColor;
      lineColor = s.getPropertyValue('--particle-line').trim() || lineColor;
    }

    // --- Pointer ---
    const pointer = { x: -9999, y: -9999, active: false };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
    });
    window.addEventListener('pointerleave', () => {
      pointer.active = false;
      pointer.x = -9999;
      pointer.y = -9999;
    });

    // ============ EFFECTS ============
    type Effect = { name: string; init: () => void; step: (t: number) => void };

    // 1. Constellation (self-clearing)
    let c2Particles: { x: number; y: number; vx: number; vy: number }[] = [];
    const constellation2: Effect = {
      name: 'Takımyıldız 2',
      init() {
        const count = Math.min(110, Math.max(28, Math.round((width * height) / 16000)));
        c2Particles = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
        }));
      },
      step() {
        ctx.clearRect(0, 0, width, height);
        const LINK = 130;
        const PD = 160;
        for (const p of c2Particles) {
          if (pointer.active) {
            const dx = p.x - pointer.x;
            const dy = p.y - pointer.y;
            const d = Math.hypot(dx, dy);
            if (d < PD && d > 0) {
              const f = (1 - d / PD) * 0.6;
              p.vx += (dx / d) * f;
              p.vy += (dy / d) * f;
            }
          }
          p.x += p.vx;
          p.y += p.vy;
          p.vx *= 0.98;
          p.vy *= 0.98;
          if (Math.abs(p.vx) < 0.04) p.vx += (Math.random() - 0.5) * 0.04;
          if (Math.abs(p.vy) < 0.04) p.vy += (Math.random() - 0.5) * 0.04;
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          if (p.y > height + 10) p.y = -10;
        }
        for (let i = 0; i < c2Particles.length; i++) {
          const a = c2Particles[i];
          for (let j = i + 1; j < c2Particles.length; j++) {
            const b = c2Particles[j];
            const d = Math.hypot(a.x - b.x, a.y - b.y);
            if (d < LINK) {
              ctx.strokeStyle = `rgba(${lineColor},${(1 - d / LINK) * 0.5})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
          if (pointer.active) {
            const d = Math.hypot(a.x - pointer.x, a.y - pointer.y);
            if (d < PD) {
              ctx.strokeStyle = `rgba(${lineColor},${(1 - d / PD) * 0.65})`;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(pointer.x, pointer.y);
              ctx.stroke();
            }
          }
        }
        ctx.fillStyle = dotColor;
        for (const p of c2Particles) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }
      },
    };

    // 2. Ripple (water)
    let ripples: { x: number; y: number; r: number; born: number }[] = [];
    let lastRippleX = -9999;
    let lastRippleY = -9999;
    let rippleBound = false;
    function onClick(e: PointerEvent) {
      ripples.push({ x: e.clientX, y: e.clientY, r: 0, born: performance.now() });
    }
    const ripple: Effect = {
      name: 'Su dalgası',
      init() {
        ripples = [];
        if (!rippleBound) {
          window.addEventListener('pointerdown', onClick);
          rippleBound = true;
        }
      },
      step(t) {
        ctx.clearRect(0, 0, width, height);
        if (pointer.active) {
          const d = Math.hypot(pointer.x - lastRippleX, pointer.y - lastRippleY);
          if (d > 90) {
            ripples.push({ x: pointer.x, y: pointer.y, r: 0, born: t });
            lastRippleX = pointer.x;
            lastRippleY = pointer.y;
          }
        }
        ripples = ripples.filter((r) => t - r.born < 2600);
        for (const rp of ripples) {
          const age = (t - rp.born) / 2600;
          rp.r = age * 260;
          ctx.strokeStyle = `rgba(${lineColor},${(1 - age) * 0.45})`;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
          ctx.stroke();
        }
      },
    };

    // 3. Circuit traces
    type CircuitPath = { pts: Pt[]; len: number; cum: number[] };
    let circuitPaths: CircuitPath[] = [];
    let circuitPulses: { path: number; d: number; speed: number }[] = [];
    function pointAtDist(path: CircuitPath, d: number): Pt {
      const cum = path.cum;
      if (d <= 0) return path.pts[0];
      if (d >= path.len) return path.pts[path.pts.length - 1];
      let i = 1;
      while (i < cum.length && cum[i] < d) i++;
      const segLen = cum[i] - cum[i - 1];
      const tt = segLen > 0 ? (d - cum[i - 1]) / segLen : 0;
      const a = path.pts[i - 1];
      const b = path.pts[i];
      return { x: a.x + (b.x - a.x) * tt, y: a.y + (b.y - a.y) * tt };
    }
    const circuit: Effect = {
      name: 'Devre izleri',
      init() {
        circuitPaths = [];
        circuitPulses = [];
        const grid = 40;
        const count = Math.max(10, Math.round(width / 95));
        for (let c = 0; c < count; c++) {
          const pts: Pt[] = [];
          let x = Math.round((Math.random() * width) / grid) * grid;
          let y = Math.round((Math.random() * height) / grid) * grid;
          pts.push({ x, y });
          const segs = 4 + Math.round(Math.random() * 5);
          let horiz = Math.random() < 0.5;
          for (let s = 0; s < segs; s++) {
            const step = (2 + Math.round(Math.random() * 4)) * grid * (Math.random() < 0.5 ? -1 : 1);
            if (horiz) x = Math.max(0, Math.min(width, x + step));
            else y = Math.max(0, Math.min(height, y + step));
            pts.push({ x, y });
            horiz = !horiz;
          }
          let len = 0;
          const cum = [0];
          for (let i = 1; i < pts.length; i++) {
            len += Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
            cum.push(len);
          }
          if (len > 0) circuitPaths.push({ pts, len, cum });
        }
      },
      step() {
        ctx.clearRect(0, 0, width, height);
        ctx.lineWidth = 1;
        ctx.strokeStyle = `rgba(${lineColor},0.14)`;
        for (const path of circuitPaths) {
          ctx.beginPath();
          ctx.moveTo(path.pts[0].x, path.pts[0].y);
          for (let i = 1; i < path.pts.length; i++) ctx.lineTo(path.pts[i].x, path.pts[i].y);
          ctx.stroke();
          ctx.fillStyle = `rgba(${lineColor},0.18)`;
          for (const p of [path.pts[0], path.pts[path.pts.length - 1]]) {
            ctx.beginPath();
            ctx.arc(p.x, p.y, 2.2, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        if (circuitPulses.length < circuitPaths.length && Math.random() < 0.22 && circuitPaths.length) {
          circuitPulses.push({ path: (Math.random() * circuitPaths.length) | 0, d: 0, speed: 90 + Math.random() * 90 });
        }
        circuitPulses = circuitPulses.filter((p) => p.d < circuitPaths[p.path].len);
        for (const pu of circuitPulses) {
          pu.d += pu.speed * 0.016;
          const path = circuitPaths[pu.path];
          const pt = pointAtDist(path, pu.d);
          const tail = pointAtDist(path, Math.max(0, pu.d - 16));
          ctx.strokeStyle = `rgba(${lineColor},0.55)`;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.moveTo(tail.x, tail.y);
          ctx.lineTo(pt.x, pt.y);
          ctx.stroke();
          ctx.fillStyle = `rgba(${lineColor},0.85)`;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 2, 0, Math.PI * 2);
          ctx.fill();
        }
      },
    };

    // 4. Boids / flocking
    let boids: { x: number; y: number; vx: number; vy: number }[] = [];
    const flock: Effect = {
      name: 'Sürü davranışı',
      init() {
        const count = Math.min(120, Math.max(40, Math.round((width * height) / 14000)));
        boids = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 2,
          vy: (Math.random() - 0.5) * 2,
        }));
      },
      step() {
        ctx.clearRect(0, 0, width, height);
        const R = 60;
        const sepR = 24;
        const maxSp = 2.2;
        for (const b of boids) {
          let ax = 0;
          let ay = 0;
          let cx = 0;
          let cy = 0;
          let sx = 0;
          let sy = 0;
          let n = 0;
          for (const o of boids) {
            if (o === b) continue;
            const dx = o.x - b.x;
            const dy = o.y - b.y;
            const d = Math.hypot(dx, dy);
            if (d < R && d > 0) {
              ax += o.vx;
              ay += o.vy;
              cx += o.x;
              cy += o.y;
              if (d < sepR) {
                sx -= dx / d;
                sy -= dy / d;
              }
              n++;
            }
          }
          if (n) {
            b.vx += (ax / n - b.vx) * 0.04 + (cx / n - b.x) * 0.0008 + sx * 0.06;
            b.vy += (ay / n - b.vy) * 0.04 + (cy / n - b.y) * 0.0008 + sy * 0.06;
          }
          if (pointer.active) {
            const dx = b.x - pointer.x;
            const dy = b.y - pointer.y;
            const d = Math.hypot(dx, dy);
            if (d < 120 && d > 0) {
              b.vx += (dx / d) * (1 - d / 120) * 0.9;
              b.vy += (dy / d) * (1 - d / 120) * 0.9;
            }
          }
          const sp = Math.hypot(b.vx, b.vy);
          if (sp > maxSp) {
            b.vx = (b.vx / sp) * maxSp;
            b.vy = (b.vy / sp) * maxSp;
          }
          b.x += b.vx;
          b.y += b.vy;
          if (b.x < 0) b.x += width;
          if (b.x > width) b.x -= width;
          if (b.y < 0) b.y += height;
          if (b.y > height) b.y -= height;
        }
        ctx.fillStyle = dotColor;
        for (const b of boids) {
          const a = Math.atan2(b.vy, b.vx);
          ctx.save();
          ctx.translate(b.x, b.y);
          ctx.rotate(a);
          ctx.beginPath();
          ctx.moveTo(5, 0);
          ctx.lineTo(-4, 3);
          ctx.lineTo(-4, -3);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }
      },
    };

    // 5. Spring chains following cursor
    let chains: { x: number; y: number }[][] = [];
    const springChain: Effect = {
      name: 'Yay zinciri',
      init() {
        const segs = 26;
        chains = Array.from({ length: 5 }, () =>
          Array.from({ length: segs }, () => ({ x: width / 2, y: height / 2 })),
        );
      },
      step(t) {
        ctx.clearRect(0, 0, width, height);
        const tx = pointer.active ? pointer.x : width / 2 + Math.cos(t * 0.0006) * width * 0.25;
        const ty = pointer.active ? pointer.y : height / 2 + Math.sin(t * 0.0009) * height * 0.25;
        for (let ci = 0; ci < chains.length; ci++) {
          const chain = chains[ci];
          const ease = 0.28 - ci * 0.035;
          chain[0].x += (tx - chain[0].x) * ease;
          chain[0].y += (ty - chain[0].y) * ease;
          for (let i = 1; i < chain.length; i++) {
            chain[i].x += (chain[i - 1].x - chain[i].x) * 0.4;
            chain[i].y += (chain[i - 1].y - chain[i].y) * 0.4;
          }
          ctx.strokeStyle = `rgba(${lineColor},${0.5 - ci * 0.07})`;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(chain[0].x, chain[0].y);
          for (let i = 1; i < chain.length; i++) ctx.lineTo(chain[i].x, chain[i].y);
          ctx.stroke();
        }
      },
    };

    // 6. Metaballs via marching squares
    let mballs: { x: number; y: number; vx: number; vy: number; r: number }[] = [];
    const metaballs: Effect = {
      name: 'Metatoplar',
      init() {
        mballs = Array.from({ length: 6 }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 1.4,
          vy: (Math.random() - 0.5) * 1.4,
          r: 60 + Math.random() * 60,
        }));
      },
      step() {
        ctx.clearRect(0, 0, width, height);
        for (const b of mballs) {
          b.x += b.vx;
          b.y += b.vy;
          if (b.x < 0 || b.x > width) b.vx *= -1;
          if (b.y < 0 || b.y > height) b.vy *= -1;
        }
        const balls: { x: number; y: number; r: number }[] = pointer.active
          ? [...mballs, { x: pointer.x, y: pointer.y, r: 90 }]
          : mballs;
        const gs = 14;
        const cols = Math.ceil(width / gs) + 1;
        const rows = Math.ceil(height / gs) + 1;
        const field = new Float32Array(cols * rows);
        for (let gy = 0; gy < rows; gy++) {
          for (let gx = 0; gx < cols; gx++) {
            const px = gx * gs;
            const py = gy * gs;
            let sum = 0;
            for (const b of balls) {
              const dx = px - b.x;
              const dy = py - b.y;
              sum += (b.r * b.r) / (dx * dx + dy * dy + 1);
            }
            field[gy * cols + gx] = sum;
          }
        }
        const T = 1;
        const interp = (va: number, vb: number) => (T - va) / (vb - va);
        ctx.strokeStyle = `rgba(${lineColor},0.5)`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        for (let gy = 0; gy < rows - 1; gy++) {
          for (let gx = 0; gx < cols - 1; gx++) {
            const tl = field[gy * cols + gx];
            const tr = field[gy * cols + gx + 1];
            const br = field[(gy + 1) * cols + gx + 1];
            const bl = field[(gy + 1) * cols + gx];
            let c = 0;
            if (tl > T) c |= 8;
            if (tr > T) c |= 4;
            if (br > T) c |= 2;
            if (bl > T) c |= 1;
            if (c === 0 || c === 15) continue;
            const x = gx * gs;
            const y = gy * gs;
            const top: Pt = { x: x + gs * interp(tl, tr), y };
            const right: Pt = { x: x + gs, y: y + gs * interp(tr, br) };
            const bottom: Pt = { x: x + gs * interp(bl, br), y: y + gs };
            const left: Pt = { x, y: y + gs * interp(tl, bl) };
            const map: Record<number, Pt[]> = {
              1: [left, bottom],
              2: [bottom, right],
              3: [left, right],
              4: [top, right],
              5: [top, left, bottom, right],
              6: [top, bottom],
              7: [top, left],
              8: [top, left],
              9: [top, bottom],
              10: [left, top, bottom, right],
              11: [top, right],
              12: [left, right],
              13: [bottom, right],
              14: [left, bottom],
            };
            const seg = map[c];
            for (let k = 0; k < seg.length; k += 2) {
              ctx.moveTo(seg[k].x, seg[k].y);
              ctx.lineTo(seg[k + 1].x, seg[k + 1].y);
            }
          }
        }
        ctx.stroke();
      },
    };

    // 7. Snake (auto-plays toward cursor)
    let snakeCell = 22;
    let snCols = 0;
    let snRows = 0;
    let snake: Pt[] = [];
    let snDir = { x: 1, y: 0 };
    let snFood = { x: 5, y: 5 };
    let snLast = 0;
    function snPlaceFood() {
      snFood = { x: (Math.random() * snCols) | 0, y: (Math.random() * snRows) | 0 };
    }
    const snakeGame: Effect = {
      name: 'Yılan',
      init() {
        snakeCell = Math.max(16, Math.round(Math.min(width, height) / 28));
        snCols = Math.ceil(width / snakeCell);
        snRows = Math.ceil(height / snakeCell);
        snake = [{ x: (snCols / 2) | 0, y: (snRows / 2) | 0 }];
        for (let i = 1; i < 5; i++) snake.push({ x: snake[0].x - i, y: snake[0].y });
        snDir = { x: 1, y: 0 };
        snPlaceFood();
        snLast = 0;
        ctx.clearRect(0, 0, width, height);
      },
      step(t) {
        const target = pointer.active
          ? {
              x: Math.min(snCols - 1, Math.max(0, Math.floor(pointer.x / snakeCell))),
              y: Math.min(snRows - 1, Math.max(0, Math.floor(pointer.y / snakeCell))),
            }
          : snFood;
        if (t - snLast > 95) {
          snLast = t;
          const head = snake[0];
          const opts = [
            { x: 1, y: 0 },
            { x: -1, y: 0 },
            { x: 0, y: 1 },
            { x: 0, y: -1 },
          ].filter((d) => !(d.x === -snDir.x && d.y === -snDir.y));
          opts.sort((a, b) => {
            const da = Math.abs(head.x + a.x - target.x) + Math.abs(head.y + a.y - target.y);
            const db = Math.abs(head.x + b.x - target.x) + Math.abs(head.y + b.y - target.y);
            return da - db;
          });
          let chosen = opts[0];
          for (const o of opts) {
            const nx = (head.x + o.x + snCols) % snCols;
            const ny = (head.y + o.y + snRows) % snRows;
            if (!snake.some((s) => s.x === nx && s.y === ny)) {
              chosen = o;
              break;
            }
          }
          snDir = chosen;
          const nh = { x: (head.x + snDir.x + snCols) % snCols, y: (head.y + snDir.y + snRows) % snRows };
          snake.unshift(nh);
          const ate = nh.x === snFood.x && nh.y === snFood.y;
          if (ate && !pointer.active) snPlaceFood();
          if (!ate) snake.pop();
          if (snake.length > 130) snake.pop();
        }
        ctx.clearRect(0, 0, width, height);
        const fx = pointer.active ? target.x : snFood.x;
        const fy = pointer.active ? target.y : snFood.y;
        ctx.fillStyle = dotColor;
        ctx.beginPath();
        ctx.arc(fx * snakeCell + snakeCell / 2, fy * snakeCell + snakeCell / 2, snakeCell * 0.28, 0, Math.PI * 2);
        ctx.fill();
        for (let i = 0; i < snake.length; i++) {
          const s = snake[i];
          ctx.fillStyle = `rgba(${lineColor},${0.7 - (i / snake.length) * 0.5})`;
          ctx.fillRect(s.x * snakeCell + 2, s.y * snakeCell + 2, snakeCell - 4, snakeCell - 4);
        }
      },
    };

    const effects: Effect[] = [
      constellation2,
      circuit,
      flock,
      springChain,
      metaballs,
      ripple,
      snakeGame,
    ];

    // Her açılışta bunlardan biri rastgele çalışır (ok tuşu / seçim yok).
    const current = effects[(Math.random() * effects.length) | 0];

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      current.init();
      if (reduceMotion) current.step(performance.now());
    }
    window.addEventListener('resize', resize);
    window.addEventListener('theme-change', () => {
      readColors();
      current.init();
      if (reduceMotion) current.step(performance.now());
    });

    readColors();
    resize();

    if (reduceMotion) {
      current.step(performance.now());
    } else {
      const loop = (t: number) => {
        current.step(t);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
