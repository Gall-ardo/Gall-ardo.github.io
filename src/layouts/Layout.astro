---
import '../styles/global.css';
import Background from '../components/Background.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.heading}`,
  description = site.bio[0],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.avatar, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/profile.jpg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;

        // Pre-hide animated elements before paint to avoid a flash before
        // GSAP runs. A safety timeout reveals them if the bundle fails to load.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('anim-pending');
          setTimeout(() => document.documentElement.classList.remove('anim-pending'), 2000);
        }
      })();
    </script>
    <!-- W3Counter visitor stats -->
    <script is:inline defer src="https://www.w3counter.com/tracker.js?id=157081"></script>
  </head>
  <body>
    <Background />
    <slot />
    <ScrollAnimations />
  </body>
</html>
